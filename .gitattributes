# Todos los archivos de texto se guardan con saltos de línea LF,
# sin importar el sistema operativo de quien los edite
* text=auto eol=lf

# Los scripts de Windows necesitan CRLF para ejecutarse bien
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Archivos binarios: Git no debe modificarlos
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.bak binary