# Backend — PlantPulse
# Plantilla de variables de entorno. Copiar a `.env` y completar.
# `.env` NUNCA se sube al repositorio (está en .gitignore).

# Servidor
PORT=3000
NODE_ENV=development

# Origen permitido para CORS (el frontend de desarrollo)
CORS_ORIGIN=http://localhost:5173

# Base de datos — Microsoft SQL Server (puerto local 1433)
DB_HOST=localhost
DB_PORT=1433
DB_NAME=PlantPulse
DB_USER=plantpulse_app
DB_PASSWORD=
DB_TRUST_SERVER_CERTIFICATE=true

# Autenticación (se usa con la historia de login)
JWT_SECRET=
JWT_EXPIRES_IN=24h
